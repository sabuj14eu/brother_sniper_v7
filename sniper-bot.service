[Unit]
Description=Brother Sniper Bot v7
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=shyam
Group=shyam
WorkingDirectory=/home/shyam/brother_sniper_v7
EnvironmentFile=/home/shyam/brother_sniper_v7/.env

ExecStart=/home/shyam/brother_sniper_v7/venv/bin/gunicorn \
    -c gunicorn.conf.py \
    bot:app

Restart=always
RestartSec=10
# Autonomy: never give up restarting. The old StartLimitBurst=5/120s meant
# five quick failures and systemd abandoned the service until a human ran
# `systemctl reset-failed` — a silent human-dependency. 0 = retry forever
# (one attempt every RestartSec).
StartLimitIntervalSec=0

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/shyam/brother_sniper_v7

[Install]
WantedBy=multi-user.target
